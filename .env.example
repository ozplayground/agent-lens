# ==========================================
# AgentLens Unified Environment Variables (Production & Development)
# ==========================================
# 복사해서 루트 .env 로 쓴다. 비밀값은 여기에 적지 않는다 (자리표시나 빈 값만).
#
# 우선순위 (backend Settings): 프로세스 환경 변수 > .env > config.json > 코드 기본값.
# - 값을 적은 줄은 config.json(설정 화면 저장 포함)을 이긴다.
# - config.json·설정 화면으로 관리하는 값(스케줄, 브리핑 Notion·메일)은 주석으로 두었다.
#   주석을 풀면 그 값이 config.json 을 이긴다. 빈 값(KEY=)으로 풀지 않는다:
#   숫자·불리언은 기동이 멈추고, 문자열은 config.json 값을 지운다.
# - LLM 키·웹훅 URL·SECRET_KEY 는 빈 값이면 config.json 값을 쓴다.
# - Docker: 컨테이너에는 .env 가 없다. 이 파일 값 가운데 docker-compose.yml environment 에
#   적힌 변수만 넘어간다 (나머지는 마운트된 config.json 이나 코드 기본값).

# Core Application Settings
PROJECT_NAME="AgentLens"
VERSION="0.4.2"
ENVIRONMENT="production"
# HOST·PORT 는 backend 가 읽지 않는다 (포트는 uvicorn 실행 인자)
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite WAL Mode / aiosqlite)
# SQLite 상대 경로는 실행 위치가 아니라 backend/ 기준이다 (이 값이면 backend/data/agentlens.db).
# 비우거나 줄을 지우면 backend/agentlens.db. Docker 는 compose 가 /app/data/agentlens.db 로 정한다.
DATABASE_URL="sqlite+aiosqlite:///./data/agentlens.db"
# RSS 피드(/api/news/feed/rss.xml) channel link 와 메일 대시보드 링크에 쓰는 웹 화면 주소
PUBLIC_WEB_URL="http://localhost:3001"

# Security (Minimum 32 characters in production)
SECRET_KEY="agentlens-super-secret-production-encryption-key-change-me-32chars"

# Crawler & Scheduling — 정하지 않으면 config.json scheduler.* (crawl_hours, timezone, enabled)
# 정하면 config.json 보다 이긴다. Docker 도 이 값을 넘긴다 (정했을 때만).
# CRAWL_SCHEDULE_HOURS="0,6,12,18"
# CRAWL_TIMEZONE="UTC"
# 수집·브리핑·딥 리서치 스케줄러를 끄려면 false
# SCHEDULER_ENABLED=true

# Optional LLM API Keys (Falls back to local zero-config NLP heuristic if empty)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_DEFAULT_CHAT_MODEL="claude-sonnet-5-5"
ANTHROPIC_HAIKU_MODEL="claude-haiku-5-5"
ANTHROPIC_SONNET_MODEL="claude-sonnet-5-5"
ANTHROPIC_OPUS_MODEL="claude-opus-5-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# 로컬 실행 기준이다. Docker 는 compose 기본값 http://host.docker.internal:11434 를 쓰므로
# 루트 .env 에 localhost 를 적으면 컨테이너에서 호스트 Ollama 에 닿지 않는다
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# 수집 평가 기준 (config.json llm.quality_cutoff_score, llm.high_signal_threshold)
QUALITY_CUTOFF_SCORE=5.0
HIGH_SIGNAL_THRESHOLD=7.0

# 챗 세션 최대 보관 수 (넘으면 오래된 것부터 지운다), 기사 본문 추출 제한 시간(초)
CHAT_SESSION_MAX_LIMIT=30
SCRAPER_TIMEOUT_SECONDS=5.0

# Webhook Notifications (Optional) — 실제 URL 은 .env 나 설정 화면에만 둔다
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# Daily Briefing — 설정 화면(config.json briefing.*)으로 관리한다. 주석을 풀면 설정 화면 저장을 이긴다.
# 브리핑 제목 (마크다운 머리, 응답, 웹훅·메일 제목, Notion 페이지 제목)
# BRIEFING_TITLE="오늘의 AI 브리핑"
# 자동 발송 시각 (CRAWL_TIMEZONE 기준 시, 매일 HH:15)
# BRIEFING_AUTO_DISPATCH_HOUR=0
# NOTION_API_KEY="secret_..."
# NOTION_PAGE_ID=""
# NOTION_AUTO_EXPORT=false
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
# SMTP_TO="team@example.com"
# SMTP_USE_TLS=true
# EMAIL_AUTO_SEND=false

# Docker Compose 호스트 포트 (컨테이너 안 포트는 backend 8000, frontend 3001 고정)
BACKEND_PORT=8000
FRONTEND_PORT=3001

# Frontend Configuration
# 브라우저가 기사 질문 스트림을 backend 에 직접 붙일 주소 (빌드 때 번들에 들어간다).
# 비우면 같은 출처(/api/..., Next rewrite → INTERNAL_API_URL)로 보낸다. Docker 빌드는 이 값을 쓰지 않는다.
NEXT_PUBLIC_API_URL=""
# Next 서버가 backend 에 붙는 주소 (rewrite 대상, next build 때 고정). make dev 는 스스로 정한다.
INTERNAL_API_URL="http://backend:8000"
# next dev 에 더 허용할 출처 (쉼표 구분, 예: "*.ts.net,192.168.0.10"). 기본은 localhost·127.0.0.1 뿐이다.
# next dev 는 루트 .env 를 읽지 않으므로 frontend/.env.local 이나 셸 환경 변수로 넘긴다.
ALLOWED_DEV_ORIGINS=""
