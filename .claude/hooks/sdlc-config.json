{
  "docs_root": "docs",
  "artifact_root": "docs/features",
  "tasks_root": "tasks",
  "plan_files_heading": "## 변경 파일",
  "gated_paths": [
    "backend/app/**",
    "frontend/src/**"
  ],
  "deploy_patterns": [
    "*git push*-tags*",
    "*git push*refs/tags/*",
    "*git push* v[0-9]*"
  ],
  "destructive_patterns": [
    "*make*reset*",
    "*curl*reset-and-collect*"
  ],
  "user_override_keywords": {
    "deploy_patterns": [
      "태그",
      "tag"
    ],
    "destructive_patterns": [
      "reset",
      "리셋",
      "초기화",
      "재수집",
      "데이터 삭제",
      "데이터를 삭제",
      "데이터 지",
      "데이터를 지",
      "db 삭제",
      "db를 삭제",
      "db 지",
      "db를 지"
    ]
  },
  "check_command": "make check",
  "high_risk": [],
  "bench_runtimes": [
    "python3",
    "node"
  ],
  "role_owners": {
    "docs/features/*/spec.md": [
      "spec-writer"
    ],
    "docs/features/*/plan.md": [
      "planner"
    ],
    "backend/app/**": [
      "implementer"
    ],
    "frontend/src/**": [
      "implementer"
    ],
    "bench/**": [
      "benchmarker"
    ]
  }
}
