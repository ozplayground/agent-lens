# ==========================================
# AgentLens Backend Environment Variables
# ==========================================

# Core Application
PROJECT_NAME="AgentLens"
VERSION="0.3.1"
ENVIRONMENT="production"
HOST="0.0.0.0"
PORT=8000
DATABASE_URL="sqlite+aiosqlite:///./data/agentlens.db"

# Security (JWT / Session Signing - Minimum 32 characters in production)
SECRET_KEY="agentlens-super-secret-production-encryption-key-change-me-32chars"

# Crawl Scheduler (0, 6, 12, 18 UTC = 09, 15, 21, 03 KST)
CRAWL_SCHEDULE_HOURS="0,6,12,18"
CRAWL_TIMEZONE="UTC"
USER_AGENT="AgentLens-Collector/1.0"

# LLM Providers (Leave blank to use built-in zero-config heuristic engine)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_COLLECTION_MODEL="claude-sonnet-5-5"
ANTHROPIC_DEFAULT_CHAT_MODEL="claude-sonnet-5-5"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# Webhook Notifications (Optional for Slack / Discord auto-dispatch)
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# Daily Briefing Integrations (Optional)
NOTION_API_KEY=""
NOTION_PAGE_ID=""

# CORS
CORS_ORIGINS='["http://localhost:3001", "http://127.0.0.1:3001"]'
